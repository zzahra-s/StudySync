# Copy to backend/.env for local development. On Vercel, set these in Project Settings -> Environment Variables.

# Supabase -> Connect -> Connection string -> "Transaction pooler" (port 6543), with your DB password filled in.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Long random string used to sign login tokens.
JWT_SECRET=change-me

# Deployed frontend URL(s), comma-separated. Leave empty locally to allow any origin.
FRONTEND_URL=

# Local port (the frontend expects 5001 by default). Not needed on Vercel.
PORT=5001
